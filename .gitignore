
---

## `.gitignore`
```gitignore
# --- Python ---
__pycache__/
*.py[cod]
*.pyd
*.so
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/

# --- Virtualenv / tooling ---
.venv/
venv/
ENV/
.env
.env.*
!.env.example

# --- IDE / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Logs / temp ---
*.log
logs/
tmp/
temp/

# --- Project outputs (avoid committing generated data) ---
outbox/
Pictures/
runs/
outputs/
data/
*.mp4
*.mkv
*.avi
*.mov
*.jpg
*.jpeg
*.png
*.webp

# Keep placeholders if you use them
!.gitkeep
