# =========================
# video2faces - environment
# =========================

# Timezone
TZ=Europe/Rome

# --- App / service ---
# Porta interna dell'app (se web/streamlit o simili)
APP_PORT=8501

# Modalità (se gestita dal tuo codice/compose)
APP_ENV=production
LOG_LEVEL=INFO

# --- Paths (host) ---
# Percorso su host dove leggere/scrivere (se monti volumi nel compose)
# Adatta ai tuoi path reali su Linux host (es. /mnt/dati/services/video2faces/...)
HOST_DATA_DIR=/mnt/dati/services/video2faces
HOST_OUTBOX_DIR=/mnt/dati/services/video2faces/outbox

# --- Paths (container) ---
CONTAINER_DATA_DIR=/app/data
CONTAINER_OUTBOX_DIR=/app/outbox

# --- Caddy / Reverse proxy (se usato) ---
# Dominio o IP su cui esponi il servizio
SITE_HOST=localhost
# Email per Let's Encrypt (solo se usi HTTPS pubblico e Caddy lo gestisce)
LETSENCRYPT_EMAIL=admin@example.local

# --- Optional: user mapping (se usi UID/GID nel Dockerfile/compose) ---
PUID=1000
PGID=1000
